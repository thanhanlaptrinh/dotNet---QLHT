                                </StackPanel>
                            </Button>

                            <Button Background="White" Foreground="#475569" BorderBrush="#DEE2E6" BorderThickness="1" Padding="15" Height="45" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
