                                </StackPanel>
                            </Button>

                            <Button Background="#D97706" Foreground="White" BorderThickness="0" Padding="15" Margin="0,0,0,10" Height="45" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✏" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center"/>
