<UserControl x:Class="QuanLiHocTap.Views.RecheckRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLiHocTap.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Height="50">
                <Button Background="Transparent" BorderThickness="0" Padding="15,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Border x:Name="ActiveLine" Height="3" Background="#1A73E8" VerticalAlignment="Bottom" Visibility="Visible"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Chờ xử lý" FontWeight="Bold" Foreground="#1A73E8" FontSize="14" VerticalAlignment="Center"/>
                        <Border Background="#FCE8E6" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="??" Foreground="#D93025" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button Background="Transparent" BorderThickness="0" Padding="15,0" Margin="10,0,0,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Border x:Name="ActiveLine" Height="3" Background="Transparent" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Đang xử lý" FontWeight="SemiBold" Foreground="#9AA0A6" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="Transparent" BorderThickness="0" Padding="15,0" Margin="10,0,0,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Border x:Name="ActiveLine" Height="3" Background="Transparent" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Đã giải quyết" FontWeight="SemiBold" Foreground="#9AA0A6" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#E2E8F0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.03"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding ReviewRequests}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F3F4"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="65">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                <Setter Property="Background" Value="#FFF5F5"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsUrgent}" Value="False"/>
                                    <Condition Binding="{Binding IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="MÃ YC" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="4" Height="45" Background="#D93025" CornerRadius="2" Margin="-10,0,5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Border Grid.Column="1" Background="#F1F3F4" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RequestId}" Foreground="#5F6368" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="HỌC VIÊN" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StudentName}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="MÔN HỌC" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CourseName}" Foreground="#5F6368" VerticalAlignment="Center" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ĐIỂM GỐC" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GradeComponent}" Value="Cuối kỳ">
                                                    <Setter Property="Background" Value="#E8F0FE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GradeComponent}" Value="Giữa kỳ">
                                                    <Setter Property="Background" Value="#FCE8E6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GradeComponent}" Value="Thực hành">
                                                    <Setter Property="Background" Value="#F1F3F4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="SemiBold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GradeComponent}" Value="Cuối kỳ">
                                                        <Setter Property="Foreground" Value="#1967D2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GradeComponent}" Value="Giữa kỳ">
                                                        <Setter Property="Foreground" Value="#C5221F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GradeComponent}" Value="Thực hành">
                                                        <Setter Property="Foreground" Value="#5F6368"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding OriginalGrade}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding GradeComponent}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="LÝ DO YÊU CẦU" Binding="{Binding Reason}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="Margin" Value="10,0"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="NGÀY NỘP" Binding="{Binding SubmitDate, StringFormat=dd/MM/yyyy}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="ƯU TIÊN" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUrgent}" Value="False">
                                                    <Setter Property="Background" Value="#F1F3F4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                        <Setter Property="Foreground" Value="#C5221F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUrgent}" Value="False">
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="HÀNH ĐỘNG" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Xử lý (UC09)" 
                                        Background="#1A73E8" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        Padding="15,6" 
                                        FontWeight="SemiBold"
                                        Height="32">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="16"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
