<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="AcademicManagementConn"
			 connectionString="Data Source=localhost;Initial Catalog=AcademicManagementDB;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="ApplicationName" value="Hệ thống QLĐT Sau đại học - Nhóm 03" />
		<add key="MaxCreditsPerSemester" value="15" />
		<add key="DefaultLanguage" value="vi-VN" />
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<entityFramework>
		<providers>
			<provider invariantName="System.Data.SqlClient"
					  type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>
</configuration>