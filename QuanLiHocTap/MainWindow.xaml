<Window x:Class="QuanLiHocTap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ Thống Quản Lí Học Tập" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="20,30">
                <TextBlock Text="QLĐT SAU ĐẠI HỌC" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Hệ thống quản lý" Foreground="#64748B" FontSize="12"/>
            </StackPanel>
      
            <StackPanel Grid.Row="1" Margin="10,0">

                <TextBlock Text="TỔNG QUAN" Foreground="#475569" FontSize="16" FontWeight="Bold" Margin="10,20,0,5"/>
                <Button Width="250"  HorizontalAlignment="Center"  HorizontalContentAlignment="Left" Padding="12,0,0,0" FontSize="14" Margin="0,5" Background="{StaticResource SidebarBrush}"  BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4,0,0,0" Click="Nav_Dashboard">
                    <WrapPanel HorizontalAlignment="Left"  Width="220">
                        <TextBlock Text="🏠" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="DashBoard" FontSize="16" Margin="0,0,10,0"/>
                    </WrapPanel>
                </Button>

                <TextBlock Text="ĐĂNG KÝ HỌC PHẦN" Foreground="#475569" FontSize="16" FontWeight="Bold" Margin="10,20,0,5"/>
                <Button Width="250"  HorizontalAlignment="Center"  HorizontalContentAlignment="Left" Padding="12,0,0,0" FontSize="14" Margin="0,5" Background="{StaticResource SidebarBrush}"  BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4,0,0,0" Click="Nav_OfferingBrowser">
                    <WrapPanel HorizontalAlignment="Left"  Width="220">
                        <TextBlock Text="🗓" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Lớp học mở" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="(OfferingBrowser)" FontSize="14" Opacity="0.7" />
                        </StackPanel>
                    </WrapPanel>
                </Button>
                <Button Width="250"  HorizontalAlignment="Center"  HorizontalContentAlignment="Left" Padding="12,0,0,0" FontSize="14" Margin="0,5" Background="{StaticResource SidebarBrush}"  BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4,0,0,0" Click="Nav_Enrollment">
                    <WrapPanel HorizontalAlignment="Left"  Width="220">
                        <TextBlock Text="👤" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Quản lý đăng ký" FontSize="16" Margin="0,0,10,0"/>
                    </WrapPanel>
                </Button>

                <TextBlock Text="ĐIỂM SỐ &amp; DUYỆT" Foreground="#475569" FontSize="16" FontWeight="Bold" Margin="10,20,0,5"/>

                <Button Width="250"  HorizontalAlignment="Center"  HorizontalContentAlignment="Left" Padding="12,0,0,0" FontSize="14" Margin="0,5" Background="{StaticResource SidebarBrush}"  BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4,0,0,0" Click="Nav_GradeEntry">
                    <WrapPanel HorizontalAlignment="Left"  Width="220">
                        <TextBlock Text="✎" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Nhập điểm (GradeEntry)" FontSize="16" Margin="0,0,10,0"/>
                    </WrapPanel>
                </Button>
                <Button Width="250"  HorizontalAlignment="Center"  HorizontalContentAlignment="Left" Padding="12,0,0,0" FontSize="14" Margin="0,5" Background="{StaticResource SidebarBrush}"  BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4,0,0,0" Click="Nav_Approval">
                    <WrapPanel HorizontalAlignment="Left"  Width="220">
                        <TextBlock Text="✔" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>                        
                            <TextBlock Text="Duyệt điểm" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="(GradeApproval)" FontSize="12" Margin="0,0,10,0"/>
                        </StackPanel>

                    </WrapPanel>
                </Button>

                <TextBlock Text="HỌC VỤ" Foreground="#475569" FontSize="16" FontWeight="Bold" Margin="10,20,0,5"/>

                <Button Width="250"  HorizontalAlignment="Center"  HorizontalContentAlignment="Left" Padding="12,0,0,0" FontSize="14" Margin="0,5" Background="{StaticResource SidebarBrush}"  BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4,0,0,0" Click="Nav_Transcrip">
                    <WrapPanel HorizontalAlignment="Left"  Width="200">
                        <TextBlock Text="📄" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Bảng điểm (Transcript)" FontSize="16" Margin="0,0,10,0"/>
                    </WrapPanel>
                </Button>
                <Button Width="250"  HorizontalAlignment="Center"  HorizontalContentAlignment="Left" Padding="12,0,0,0" FontSize="14" Margin="0,5" Background="{StaticResource SidebarBrush}"  BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4,0,0,0" Click="Nav_Recheck">
                    <WrapPanel HorizontalAlignment="Left"  Width="200">
                        <TextBlock Text="🕒" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Phúc khảo (Recheck)" FontSize="16" Margin="0,0,10,0"/>
                    </WrapPanel>
                </Button>

                <TextBlock Text="BÁO CÁO" Foreground="#475569" FontSize="16" FontWeight="Bold" Margin="10,20,0,5"/>

                <Button Width="250"  HorizontalAlignment="Center"  HorizontalContentAlignment="Left" Padding="12,0,0,0" FontSize="14" Margin="0,5" Background="{StaticResource SidebarBrush}"  BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4,0,0,0" Click="Nav_Statis">
                    <WrapPanel HorizontalAlignment="Left"  Width="200">
                        <TextBlock Text="📊" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Thống kê (Statistics)" FontSize="16" Margin="0,0,10,0"/>
                    </WrapPanel>
                </Button>

                <!--<TextBlock Text="ĐIỂM SỐ &amp; DUYỆT" Foreground="#475569" FontSize="16" FontWeight="Bold" Margin="10,20,0,5"/>

                <Button Width="250"  HorizontalAlignment="Center"  HorizontalContentAlignment="Left" Padding="12,0,0,0" FontSize="14" Margin="0,5" Background="{StaticResource SidebarBrush}"  BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4,0,0,0" Click="Nav_Dashboard">
                    <WrapPanel HorizontalAlignment="Left"  Width="200">
                        <TextBlock Text="👤" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Quản lý đăng ký" FontSize="16" Margin="0,0,10,0"/>
                    </WrapPanel>
                </Button>-->


            </StackPanel>

            <Button Grid.Row="2" Padding="15" Background="#111A2E" Click="Nav_Account">
                <StackPanel Orientation="Horizontal">
                    <Border Background="BlueViolet"  Width="30" Height="30" CornerRadius="50" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <TextBlock Text="VT" Foreground="White"  FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0">
                        <TextBlock Text="Nguyễn Văn Thành" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="Học sinh" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10" Background="White">
                <StackPanel HorizontalAlignment="Left" Width="auto" Grid.Column="0" VerticalAlignment="Center" Margin="30,20,0,20">
                    <TextBlock x:Name="txtPageTitle" Text="Tổng quan hệ thống" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="txtPageDesc" Text="Trang chủ" FontSize="20" Foreground="{StaticResource GrayBrush}"/>
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <ComboBox Width="170" Height="35" VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0">
                        <ComboBoxItem Content="Học kỳ 2 - 2026" IsSelected="True"/>
                    </ComboBox>
                    <Button Content="🔔" Width="40" Background="#f2f2f2" Foreground="Black" BorderThickness="1" BorderBrush="{StaticResource BorderBrushX}"/>
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="1" Background="{StaticResource BackgroundMainContentBrush}">
                <UserControl x:Name="MainContent"/>
            </Grid>
        </Grid>
    </Grid>
</Window>